# EAJ CourtPrime — production environment template.
#
# Copy to .env on the server and fill in every value marked CHANGE ME. The
# defaults here are the production ones, not the development ones, so that a
# server built by copying this file is safe by default rather than safe only if
# somebody remembered to harden it.
#
# For local development, the three that need changing back are:
#   APP_ENV=local  APP_DEBUG=true  MAIL_MAILER=log
#
# Two background processes are not optional — see the checklist at the bottom.

APP_NAME="EAJ CourtPrime"
APP_ENV=production
# php artisan key:generate --force
APP_KEY=
# Never true on a public server: it prints stack traces, SQL and file paths to
# whoever triggered the error.
APP_DEBUG=false

# UTC, always. Each club carries its own timezone on its organization record
# and the app converts for display; setting this to local time double-shifts
# every stored timestamp.
APP_TIMEZONE=UTC

# CHANGE ME — the real public URL, with https. This builds the links in email,
# the URLs for uploaded player portraits, and the QR payment return address, so
# leaving it as localhost breaks all three in ways that only show up in
# production.
APP_URL=https://courtprime.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily rather than single: one file per day, rotated, so a long-running server
# does not end up with a log too big to open.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug logs every query and every payload, including personal data.
LOG_LEVEL=error

# ---- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courtprime
# CHANGE ME — a user scoped to this database only, never root.
DB_USERNAME=courtprime
DB_PASSWORD=

# ---- Sessions ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# CHANGE ME — the cookie domain, e.g. .courtprime.example.com
SESSION_DOMAIN=null
# Requires https. The open play board holds are proved by a session cookie, so
# a cookie sent in the clear is somebody else's board.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail -------------------------------------------------------------------
# CHANGE ME. On `log` nothing is ever delivered — password resets and email
# verification silently go nowhere and a locked-out user stays locked out.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@courtprime.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- PayMongo — QRPh subscription payments ----------------------------------
# Leave blank to keep billing read-only: the billing page still shows what is
# owed, it just cannot raise a QR to pay it. Live keys start sk_live_/pk_live_.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ---- Seeding ----------------------------------------------------------------
# The seeders create a platform operator and a demo club with staff logins. In
# production they refuse to run without a password set here, rather than
# quietly creating accounts whose password is `password`. Leave blank and do
# not seed if you would rather create the first account by hand.
SEED_PASSWORD=
SEED_SUPERADMIN_EMAIL=

# ---- Subscription billing behaviour -----------------------------------------
BILLING_CYCLE_MONTHS=1
BILLING_NOTIFY_DAYS=3
BILLING_LOCK_GRACE_DAYS=2
BILLING_MIN_AMOUNT=20

# -----------------------------------------------------------------------------
# Deploying
#
#   composer install --no-dev --optimize-autoloader
#   npm ci && npm run build
#   php artisan key:generate --force        # only on a new server
#   php artisan migrate --force
#   php artisan storage:link                # uploaded portraits 404 without it
#   php artisan config:cache route:cache view:cache
#
# Two processes, both required. Without them subscriptions never renew, never
# lapse, and nobody is reminded of anything — silently, with no error anywhere.
#
#   Cron, every minute:
#     * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
#
#   Queue worker, kept alive by supervisor or systemd:
#     php artisan queue:work --tries=3 --max-time=3600
#
# After deploying, check:
#   - an error page shows no stack trace
#   - a password reset email actually arrives
#   - a player portrait uploaded in the app renders on /display/live
# -----------------------------------------------------------------------------
